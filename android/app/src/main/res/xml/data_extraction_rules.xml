<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction policy.

  Mizan stores ledger data, session material and cached receipts on the device.
  None of it belongs in cloud backups or device-to-device transfers, so every
  domain is excluded. Restoring a device must go through the app's own encrypted
  backup flow instead of an unattended platform copy.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
