# File: zai/.env.example — copy to zai/apps/api/.env and fill in real values.
# NEVER commit a real .env file. No value below is a real secret.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (see zai/infra/docker-compose.yml for local dev)
DATABASE_URL=postgresql://zai:zai_dev_password@localhost:5432/zai

# Redis connection string, used for rate limiting
REDIS_URL=redis://localhost:6379

# >= 32 random characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars-long
COOKIE_SECRET=replace-with-a-different-random-secret-at-least-32-chars

# Comma-separated list of exact frontend origins allowed to call this API.
# Never use "*".
ALLOWED_ORIGINS=http://localhost:8080,https://your-production-domain.example

# S3-compatible object storage for attachments (any provider: AWS S3, R2,
# MinIO, Backblaze B2). Leave unset to disable attachment uploads.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=zai-attachments
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key

# Model provider credentials — held ONLY here, server-side. Never exposed to
# the frontend bundle under any circumstance.
MODEL_PROVIDER_BASE_URL=https://api.your-model-provider.example
MODEL_PROVIDER_API_KEY=replace-with-provider-api-key

# Optional: enables `/cfsa --scope cloudflare` (read-only GET calls only).
# Leave unset to skip the Cloudflare scope entirely.
CF_API_TOKEN=
CF_ZONE_ID=
