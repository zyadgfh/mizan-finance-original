{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-Ai",
  "version": "1.0.0",
  "identifier": "ai.z-ai.desktop",
  "build": {
    "devUrl": "http://localhost:8080/zai",
    "frontendDist": "../../../.vercel/output/static"
  },
  "app": {
    "windows": [
      {
        "title": "Z-Ai",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": ["icons/icon.png"]
  }
}
